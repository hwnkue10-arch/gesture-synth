{
  "name": "gesture-synth",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35"
  },
  "build": {
    "appId": "com.gesturesynth.app",
    "productName": "GestureSynth",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "models/**/*",
      "bridge_openvino.py"
    ],
    "extraResources": [
      "bridge_openvino.py",
      "models/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
